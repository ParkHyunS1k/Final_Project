# Supabase(Google 로그인). Supabase 대시보드 → Project Settings → API.
# 서버(토큰 검증)
SUPABASE_URL=
# 화면(빌드 시 포함, 공개돼도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DB. 비우면 로컬 PGlite(web/.data/pglite)를 쓴다.
# Supabase → Project Settings → Database → Connection pooling(Transaction mode, 6543) 주소. 비밀값이다.
DATABASE_URL=
# 로컬 PGlite 경로(기본 .data/pglite)
DATABASE_PATH=
# 초대 링크 메일(Gmail SMTP). 셋 다 있어야 보낸다. 앱 비밀번호는 비밀값이다.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
# AI 키는 서버 전용. 비우면 이력서는 기본 키워드 추출만 사용한다.
OPENAI_API_KEY=
# Jooble 채용공고 검색 API 키(서버 전용, NEXT_PUBLIC_ 금지)
JOOBLE_API_KEY=
# 이력서 분석 모델 override. 없으면 PROJECTMATE_MODEL, 이후 서비스 기본값 사용.
CAREERFLOW_MODEL=
# 기존 회의록 AI 활성화(1)와 모델 override. 이력서 AI 동의·한도와는 별도다.
PROJECTMATE_LIVE_MODEL=
PROJECTMATE_MODEL=
