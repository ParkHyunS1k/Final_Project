      "model": [
        { "changeId": "a", "kind": "createTask", "newKey": "k1", "after": { "title": "배포 스크립트 정리", "person": 2, "remaining": 3, "dependsOn": [] }, "evidenceText": "할 일: 배포 스크립트 정리, 3시간", "basis": "fact" }
