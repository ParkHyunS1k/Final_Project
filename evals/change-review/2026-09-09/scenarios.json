      { "id": 3, "title": "로그인 화면 QA", "person": 1, "status": "todo", "remaining": 2, "done": false, "dueAt": null }
    ]
  },
  "cases": [
    {
      "id": "GR-01",
      "why": "원문에 있는 사실 보고는 근거를 붙여 통과해야 한다.",
      "source": "결제 연동 4시간 남았습니다.",
      "model": [
        { "changeId": "a", "kind": "remaining", "taskId": 2, "after": { "remaining": 4 }, "evidenceText": "결제 연동 4시간 남았습니다.", "basis": "fact" }
      ],
      "expect": { "accepted": ["a"], "rejected": [], "needsReview": [] }
    },
    {
      "id": "GR-02",
      "why": "존재하지 않는 업무 ID는 적용 대상이 되지 않아야 한다.",
      "source": "무언가 진행 중",
      "model": [
        { "changeId": "a", "kind": "status", "taskId": 99, "after": { "status": "in_progress" } }
      ],
      "expect": { "accepted": [], "rejected": ["a"], "needsReview": [] }
