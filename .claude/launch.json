{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "projectmate-web",
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "github-timeline-review",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8791",
        "--directory",
        "datasets/github-timeline-candidates-v1"
      ],
      "port": 8791
    },
    {
      "name": "landing-race",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "projectmate-ai-off",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AI_FAKE_MODEL=0",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3101"
      ],
      "port": 3101
    },
    {
      "name": "workspace-ui",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=",
        "DATABASE_PATH=.data/pglite-ui",
        "NEXT_PUBLIC_SUPABASE_URL=",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY=",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3102"
      ],
      "port": 3102
    }
  ]
}
